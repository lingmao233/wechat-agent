# Runtime
WECHAT_WINDOW_CLASS=mmui::MainWindow
WECHAT_EXE=C:\\Program Files\\Tencent\\Weixin\\Weixin.exe
WECHAT_GROUP_NAMES=
# 旧版单群配置；存在 WECHAT_GROUP_NAMES 时以新配置为准。
WECHAT_GROUP_NAME=
# 机器人名称：只匹配显式 @ 或消息开头的名称，不会匹配普通回答中的“AI”。
WECHAT_AI_ALIASES=AI,ai,机器人
# 任意位置关键词：命中其中一项才触发关键词回复。
WECHAT_KEYWORDS=问AI,小助手
WECHAT_SELF_NAME=
# 逗号分隔的微信唯一 member_id/wxid；留空表示不限制成员，昵称不作为白名单键。
WECHAT_ALLOWED_MEMBERS=
WECHAT_ALLOW_SEND=false
# 主动发言：默认关闭；开启后只对安慰、接梗、明显提问等社交信号择机插话。
WECHAT_PROACTIVE_REPLY=false
WECHAT_PROACTIVE_MIN_INTERVAL_SECONDS=300
WECHAT_PROACTIVE_MAX_PER_HOUR=6
WECHAT_PROACTIVE_PROBABILITY=0.4
WECHAT_POLL_SECONDS=2
# 回复队列：忙不过来时消息按到达顺序排队，每轮只回一条；0 表示不限长度。
WECHAT_REPLY_QUEUE_MAX_SIZE=50
# 回复频率控制：0 表示不额外限制；只对已命中 @/关键词且实际成功发送的回复计数。
WECHAT_REPLY_COOLDOWN_SECONDS=0
WECHAT_MAX_REPLIES_PER_HOUR=0
WECHAT_STOP_FILE=state/STOP
WECHAT_PROCESSING_LEASE_SECONDS=300
# Do not answer messages that were already visible before this listener started.
WECHAT_SKIP_EXISTING_ON_START=true
# 最近群消息会作为临时上下文传给模型；只查询当前微信号和当前群。
WECHAT_CONTEXT_MESSAGES=12
WECHAT_CONTEXT_MAX_CHARS=6000
# 读取微信数据库中的图片附件并交给支持视觉输入的模型。
WECHAT_IMAGE_RECOGNITION_ENABLED=true
WECHAT_IMAGE_MAX_COUNT=4
WECHAT_IMAGE_MAX_BYTES=12000000
# 图片只在接下来的几条消息里参与回答；更早的图要等群友重新提到才会再带上。
WECHAT_IMAGE_CONTEXT_TURNS=4
WECHAT_IMAGE_REFERENCE_WINDOW=30
# 以下三个目录和 DATABASE_URL 可以整体指到其他磁盘，例如
#   WECHAT_MEDIA_DIR=D:/wechat-agent-data/wechat-media
#   IMAGE_OUTPUT_DIR=D:/wechat-agent-data/generated
#   DATABASE_URL=sqlite:///D:/wechat-agent-data/memory.db
WECHAT_MEDIA_DIR=state/wechat-media
IMAGE_OUTPUT_DIR=state/generated
EMBED_BASE=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
EMBED_MODEL=doubao-embedding-vision-251215
EMBED_KEY=
# 0 accepts the provider dimension; the configured model currently returns 2048.
EMBED_DIMENSION=0
EMBED_TIMEOUT_SECONDS=45
# Optional OpenViking REST base. Leave empty to use the local SQL/embedding fallback.
OPENVIKING_ENABLED=true
OPENVIKING_URL=
OPENVIKING_API_KEY=
# The API key used by this agent is scoped to the OpenViking user ``ds``.
OPENVIKING_NAMESPACE=ds
OPENVIKING_TIMEOUT_SECONDS=45
# 连接失败最多等待 5 秒；失败后 300 秒内直接使用本地回退，避免每条消息卡住。
OPENVIKING_CONNECT_TIMEOUT_SECONDS=5
OPENVIKING_FAILURE_COOLDOWN_SECONDS=300
OPENVIKING_COMMIT=true
# 画像镜像按 scope 合并写入，避免每条消息都上传完整画像。
OPENVIKING_PROFILE_MIN_INTERVAL_SECONDS=30
# 群聊风格拟合：只保存按账号+群聚合的统计画像，不保存群聊原文。
GROUP_STYLE_ENABLED=true
GROUP_STYLE_MIN_MESSAGES=20
GROUP_STYLE_REFRESH_MESSAGES=20
# 事件指纹保留上限，用于防止重放计数；不会保存对应消息正文。
GROUP_STYLE_SAMPLE_MESSAGES=80
GROUP_STYLE_MAX_CHARS=1800
# 画像只用最近 N 条消息重建，避免永久累加导致风格漂移。
GROUP_STYLE_WINDOW_MESSAGES=300
# 注入 prompt 的画像摘要上限（完整审计画像仍留在 SQL/OpenViking）。
PROFILE_PROMPT_MAX_CHARS=4000
# 用 LLM 从最近群聊合成 culture/jokes/nicknames/rules 等语义画像。
PROFILE_SYNTHESIS_ENABLED=true
PROFILE_SYNTHESIS_MESSAGES=120
PROFILE_SYNTHESIS_MAX_INPUT_CHARS=6000

# Local desktop control console. Use a token before binding beyond localhost.
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8765
DESKTOP_TOKEN=

# 抖音 / 小红书可见浏览器连接器（默认关闭；开启后分别保存独立登录态）
PLATFORM_BROWSER_ENABLED=false
PLATFORM_BROWSER_DATA_DIR=browser-data
# 留空自动寻找 Chrome / Edge；也可以填写 chrome.exe 的绝对路径
PLATFORM_BROWSER_EXECUTABLE=
PLATFORM_BROWSER_HEADLESS=false
DOUYIN_ACCOUNT_ID=unbound
XIAOHONGSHU_ACCOUNT_ID=unbound
PLATFORM_BROWSER_SCROLL_STEPS=5
PLATFORM_BROWSER_PAGE_TIMEOUT_MS=20000
# 评论/回复仍需人工确认；默认不执行真实外发
PLATFORM_WRITE_ENABLED=false
PLATFORM_ACTION_DELAY_SECONDS=30
PLATFORM_MAX_ACTIONS_PER_HOUR=5

# 联网研究（搜索和网页正文抓取分别控制）
# deepseek-search-api 使用 DSH 同款局域网中转；也可填 brave / tavily / searxng / none
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=deepseek-search-api
WEB_SEARCH_API_KEY=lan
WEB_SEARCH_BASE_URL=http://192.168.20.38:8787/v1/tools
WEB_SEARCH_MAX_RESULTS=5
# 开启后，消息中的 http(s) URL 会直接走本地 HTTP 抓取；空白域名列表表示允许所有公开网站。
WEB_FETCH_ENABLED=false
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_MAX_CHARS=6000
WEB_TIMEOUT_SECONDS=15

# Use SQLite for the first local test. Set PostgreSQL before shared deployment.
# Windows 的绝对路径写成 sqlite:///D:/wechat-agent-data/memory.db 这种形式。
DATABASE_URL=sqlite:///state/memory.db
RAW_RETENTION_DAYS=30
CHAT_HALF_LIFE_DAYS=14
INTEREST_HALF_LIFE_DAYS=90
FACT_HALF_LIFE_DAYS=365

# OpenAI-compatible endpoint. DeepSeek is the default provider when configured.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=3000
# 模型效果调节：温度越高越有变化；Top-P/重复惩罚为 1/0 时不额外发送对应参数。
LLM_TEMPERATURE=0.7
LLM_TOP_P=1
LLM_FREQUENCY_PENALTY=0
LLM_PRESENCE_PENALTY=0

# 人设：默认使用项目内置的大肥鱼；可改为任意 Markdown 文件，旁边的 references/ 会一并读取。
PERSONA_ENABLED=true
PERSONA_NAME=大肥鱼
PERSONA_FILE=personas/dafeiyu/SKILL.md
PERSONA_SOURCE_URL=https://github.com/ERUIHNIYHBKBNF/dafeiyu-persona
PERSONA_MAX_CHARS=12000
# 输出后处理：拦截自称 AI、吐泡泡和过激脏话；表情默认每条最多 1 个。
PERSONA_STYLE_FILTER=true
PERSONA_MAX_EMOJI=1

# 每晚本地导出当天群聊，供后续风格/行为数据整理；只导出，不自动训练权重。
TRAINING_EXPORT_ENABLED=false
TRAINING_EXPORT_DIR=data/training/daily
TRAINING_EXPORT_HOUR=23
TRAINING_EXPORT_MINUTE=30
TRAINING_EXPORT_CONTEXT_MESSAGES=6
TRAINING_EXPORT_ANONYMIZE=true

# 可选的第二个模型：明确要求“生成图片/画一张/生图”时才调用。
# 接口：POST {IMAGE_MODEL_BASE_URL}/images/generations
IMAGE_MODEL_ENABLED=false
IMAGE_MODEL_BASE_URL=
IMAGE_MODEL_API_KEY=
IMAGE_MODEL=
IMAGE_MODEL_SIZE=1024x1024
IMAGE_MODEL_RESPONSE_FORMAT=auto
IMAGE_MODEL_TIMEOUT_SECONDS=120

# 可选：把生图结果直接上传到阿里云 OSS，供其他客户端访问；微信连接器
# 始终优先发送本地原生图片附件，OSS 暂时不可用不会阻断微信发送。
IMAGE_UPLOAD_ENABLED=false
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=m5-model
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=seedance-assets
# 私有 bucket 留空，程序会生成有效期为 7200 秒的 OSS 签名 URL。
OSS_SIGNED_URL_TTL_SECONDS=7200
# 公共 bucket 或 CDN 域名；填写后返回长期可访问的公开 URL。
OSS_PUBLIC_BASE_URL=
IMAGE_UPLOAD_TIMEOUT_SECONDS=120
IMAGE_UPLOAD_MAX_BYTES=20000000

# Account binding is intentionally explicit and local to the test group.
BINDING_CODE_TTL_MINUTES=10
