# Runtime
WECHAT_WINDOW_CLASS=mmui::MainWindow
WECHAT_EXE=C:\\Program Files\\Tencent\\Weixin\\Weixin.exe
WECHAT_GROUP_NAME=
# 机器人名称：只匹配显式 @ 或消息开头的名称，不会匹配普通回答中的“AI”。
WECHAT_AI_ALIASES=AI,ai,机器人
# 任意位置关键词：命中其中一项才触发关键词回复。
WECHAT_KEYWORDS=问AI,小助手
WECHAT_SELF_NAME=
# 逗号分隔的微信唯一 member_id/wxid；留空表示不限制成员，昵称不作为白名单键。
WECHAT_ALLOWED_MEMBERS=
WECHAT_ALLOW_SEND=false
# Ordinary messages never invoke the model; they must contain an AI alias.
WECHAT_PROACTIVE_REPLY=false
WECHAT_POLL_SECONDS=2
WECHAT_STOP_FILE=state/STOP
WECHAT_PROCESSING_LEASE_SECONDS=300
# Do not answer messages that were already visible before this listener started.
WECHAT_SKIP_EXISTING_ON_START=true
# 最近群消息会作为临时上下文传给模型；只查询当前微信号和当前群。
WECHAT_CONTEXT_MESSAGES=12
WECHAT_CONTEXT_MAX_CHARS=6000

# Local desktop control console. Use a token before binding beyond localhost.
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8765
DESKTOP_TOKEN=

# 抖音 / 小红书可见浏览器连接器（默认关闭；开启后分别保存独立登录态）
PLATFORM_BROWSER_ENABLED=false
PLATFORM_BROWSER_DATA_DIR=browser-data
# 留空自动寻找 Chrome / Edge；也可以填写 chrome.exe 的绝对路径
PLATFORM_BROWSER_EXECUTABLE=
PLATFORM_BROWSER_HEADLESS=false
DOUYIN_ACCOUNT_ID=unbound
XIAOHONGSHU_ACCOUNT_ID=unbound
PLATFORM_BROWSER_SCROLL_STEPS=5
PLATFORM_BROWSER_PAGE_TIMEOUT_MS=20000
# 评论/回复仍需人工确认；默认不执行真实外发
PLATFORM_WRITE_ENABLED=false
PLATFORM_ACTION_DELAY_SECONDS=30
PLATFORM_MAX_ACTIONS_PER_HOUR=5

# 联网研究（搜索和网页正文抓取分别控制）
# deepseek-search-api 使用 DSH 同款局域网中转；也可填 brave / tavily / searxng / none
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=deepseek-search-api
WEB_SEARCH_API_KEY=lan
WEB_SEARCH_BASE_URL=http://192.168.20.38:8787/v1/tools
WEB_SEARCH_MAX_RESULTS=5
# 开启后，消息中的 http(s) URL 会直接走本地 HTTP 抓取；空白域名列表表示允许所有公开网站。
WEB_FETCH_ENABLED=false
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_MAX_CHARS=6000
WEB_TIMEOUT_SECONDS=15

# Use SQLite for the first local test. Set PostgreSQL before shared deployment.
DATABASE_URL=sqlite:///state/memory.db
RAW_RETENTION_DAYS=30
CHAT_HALF_LIFE_DAYS=14
INTEREST_HALF_LIFE_DAYS=90
FACT_HALF_LIFE_DAYS=365

# OpenAI-compatible endpoint. DeepSeek is the default provider when configured.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=500

# 人设：默认使用项目内置的大肥鱼；可改为任意 Markdown 文件，旁边的 references/ 会一并读取。
PERSONA_ENABLED=true
PERSONA_NAME=大肥鱼
PERSONA_FILE=personas/dafeiyu/SKILL.md
PERSONA_SOURCE_URL=https://github.com/ERUIHNIYHBKBNF/dafeiyu-persona
PERSONA_MAX_CHARS=12000

# 可选的第二个模型：明确要求“生成图片/画一张/生图”时才调用。
# 接口：POST {IMAGE_MODEL_BASE_URL}/images/generations
IMAGE_MODEL_ENABLED=false
IMAGE_MODEL_BASE_URL=
IMAGE_MODEL_API_KEY=
IMAGE_MODEL=
IMAGE_MODEL_SIZE=1024x1024
IMAGE_MODEL_RESPONSE_FORMAT=url
IMAGE_MODEL_TIMEOUT_SECONDS=120

# 可选：把生图结果直接上传到阿里云 OSS，再把公开或签名 URL 发到群里。
IMAGE_UPLOAD_ENABLED=false
OSS_REGION=cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=m5-model
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=seedance-assets
# 私有 bucket 留空，程序会生成有效期为 7200 秒的 OSS 签名 URL。
OSS_SIGNED_URL_TTL_SECONDS=7200
# 公共 bucket 或 CDN 域名；填写后返回长期可访问的公开 URL。
OSS_PUBLIC_BASE_URL=
IMAGE_UPLOAD_TIMEOUT_SECONDS=120
IMAGE_UPLOAD_MAX_BYTES=20000000

# Account binding is intentionally explicit and local to the test group.
BINDING_CODE_TTL_MINUTES=10
